{
  "name": "resume-buzz",
  "version": "0.1.0",
  "private": true,
  "description": "Paste a job posting. Get your resume tailored to it, with a word-level diff and a cover letter.",
  "license": "MIT",
  "author": "Tyler Clark",
  "homepage": "https://resume.buzz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tylerclark/resume.buzz.git"
  },
  "bugs": {
    "url": "https://github.com/tylerclark/resume.buzz/issues"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "next dev -p 4719",
    "build": "next build",
    "start": "next start -p 4719",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "check": "pnpm lint && pnpm typecheck",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit \"$1\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@mendable/firecrawl-js": "^4.50.0",
    "@neondatabase/serverless": "^1.2.0",
    "@react-pdf/renderer": "^4.9.0",
    "better-auth": "^1.7.11",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "mammoth": "^1.13.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.20.0"
}
