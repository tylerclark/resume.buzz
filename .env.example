# Copy to .env.local and fill in. Nothing here is optional except AI_GATEWAY_MODEL.

# Neon Postgres connection string (free tier works). On Vercel the Neon integration
# sets this for you; pull it with `vercel env pull .env.local`.
DATABASE_URL=

# BetterAuth. Generate the secret with `openssl rand -base64 32`.
# BETTER_AUTH_URL is the public origin of the app.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4719

# Resend, used to email sign-in codes. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="resume.buzz <login@resume.buzz>"

# Sign-in allowlist: comma-separated emails. Empty means nobody can sign in (fail closed),
# so put your own address here when self-hosting.
ALLOWED_EMAILS=you@example.com

# Claude via Vercel AI Gateway (https://vercel.com/ai-gateway). On Vercel, VERCEL_OIDC_TOKEN
# is used automatically if no key is set. AI_GATEWAY_MODEL is any Anthropic model the gateway offers.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=anthropic/claude-opus-5.5

# Firecrawl, used to scrape job postings (https://firecrawl.dev).
FIRECRAWL_API_KEY=
