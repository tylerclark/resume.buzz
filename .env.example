# Neon (auto-set by the Vercel Neon integration; pull with `vercel env pull .env.local`)
DATABASE_URL=

# BetterAuth — generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend (email OTP). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="resume.buzz <login@resume.buzz>"

# Optional: comma-separated list of emails allowed to sign in. Empty = open sign-up.
ALLOWED_EMAILS=

# Claude via Vercel AI Gateway (on Vercel, VERCEL_OIDC_TOKEN is used if no key is set)
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=anthropic/claude-opus-5

# Firecrawl
FIRECRAWL_API_KEY=
